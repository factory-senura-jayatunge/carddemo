      ******************************************************************
      * KSDS load/unload utility for dataset @DATASET@ (IDCAMS REPRO
      * stand-in). Generated by tools/carddemo.py from
      * tools/templates/repro.cbl.in; the key layout comes from
      * tools/batch-programs.toml and must match the programs' SELECTs.
      *   LOAD   : LSFILE (fixed-length records, RECFM=FB) -> KSFILE
      *   UNLOAD : KSFILE (indexed, key order) -> LSFILE
      * Records may hold binary data, so LSFILE is record sequential,
      * not LINE SEQUENTIAL.
      ******************************************************************
       IDENTIFICATION DIVISION.
       PROGRAM-ID. REPROKS.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT LS-FILE ASSIGN TO LSFILE
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-LS-STATUS.
           SELECT KS-FILE ASSIGN TO KSFILE
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS KS-KEY
@ALTERNATE-KEYS@
               FILE STATUS IS WS-KS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  LS-FILE.
       01  LS-REC                  PIC X(@LRECL@).
       FD  KS-FILE.
       01  KS-REC.
@KS-FIELDS@
       WORKING-STORAGE SECTION.
       01  WS-LS-STATUS            PIC XX.
       01  WS-KS-STATUS            PIC XX.
       01  WS-MODE                 PIC X(16).
       01  WS-COUNT                PIC 9(9) VALUE 0.
       01  WS-EOF                  PIC X VALUE 'N'.
       01  WS-WHAT                 PIC X(24).
       PROCEDURE DIVISION.
           ACCEPT WS-MODE FROM COMMAND-LINE
           EVALUATE WS-MODE
               WHEN 'LOAD'
                   PERFORM LOAD-KSDS
               WHEN 'UNLOAD'
                   PERFORM UNLOAD-KSDS
               WHEN OTHER
                   DISPLAY 'usage: LOAD | UNLOAD' UPON SYSERR
                   MOVE 16 TO RETURN-CODE
                   STOP RUN
           END-EVALUATE
           DISPLAY '@DATASET@ ' WS-MODE(1:6) ' ' WS-COUNT ' RECORDS'
           STOP RUN.

       LOAD-KSDS.
           OPEN INPUT LS-FILE
           MOVE 'OPEN LSFILE' TO WS-WHAT
           IF WS-LS-STATUS NOT = '00' PERFORM LS-ERROR END-IF
           OPEN OUTPUT KS-FILE
           MOVE 'OPEN KSFILE' TO WS-WHAT
           IF WS-KS-STATUS NOT = '00' PERFORM KS-ERROR END-IF
           PERFORM UNTIL WS-EOF = 'Y'
               READ LS-FILE
                   AT END MOVE 'Y' TO WS-EOF
               END-READ
               IF WS-EOF = 'N'
                   MOVE 'READ LSFILE' TO WS-WHAT
                   IF WS-LS-STATUS NOT = '00' PERFORM LS-ERROR END-IF
                   WRITE KS-REC FROM LS-REC
                   MOVE 'WRITE KSFILE' TO WS-WHAT
                   IF WS-KS-STATUS NOT = '00' PERFORM KS-ERROR END-IF
                   ADD 1 TO WS-COUNT
               END-IF
           END-PERFORM
           CLOSE LS-FILE KS-FILE.

       UNLOAD-KSDS.
           OPEN INPUT KS-FILE
           MOVE 'OPEN KSFILE' TO WS-WHAT
           IF WS-KS-STATUS NOT = '00' PERFORM KS-ERROR END-IF
           OPEN OUTPUT LS-FILE
           MOVE 'OPEN LSFILE' TO WS-WHAT
           IF WS-LS-STATUS NOT = '00' PERFORM LS-ERROR END-IF
           PERFORM UNTIL WS-EOF = 'Y'
               READ KS-FILE NEXT RECORD
                   AT END MOVE 'Y' TO WS-EOF
               END-READ
               IF WS-EOF = 'N'
                   MOVE 'READ KSFILE' TO WS-WHAT
                   IF WS-KS-STATUS NOT = '00' PERFORM KS-ERROR END-IF
                   WRITE LS-REC FROM KS-REC
                   MOVE 'WRITE LSFILE' TO WS-WHAT
                   IF WS-LS-STATUS NOT = '00' PERFORM LS-ERROR END-IF
                   ADD 1 TO WS-COUNT
               END-IF
           END-PERFORM
           CLOSE KS-FILE LS-FILE.

       LS-ERROR.
           DISPLAY '@DATASET@: ' WS-WHAT ' FILE STATUS ' WS-LS-STATUS
               ' AT RECORD ' WS-COUNT UPON SYSERR
           MOVE 12 TO RETURN-CODE
           STOP RUN.

       KS-ERROR.
           DISPLAY '@DATASET@: ' WS-WHAT ' FILE STATUS ' WS-KS-STATUS
               ' AT RECORD ' WS-COUNT UPON SYSERR
           MOVE 12 TO RETURN-CODE
           STOP RUN.
