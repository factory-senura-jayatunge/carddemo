# Local overrides for the Makefile and tools/carddemo.py.
# Copy to .env (git-ignored) and uncomment what you need; `make` reads it.
# Every value shown is the default used when the variable is unset.

# Python interpreter (3.11 or newer).
# PYTHON=python3

# GnuCOBOL 3.2 compiler, if `cobc` on PATH is a different version.
# COBC=cobc

# Business date the batch programs see (COB_CURRENT_DATE), YYYY-MM-DD or
# "YYYY-MM-DD HH:MM:SS", or "now" for the system clock. The default is the
# sample data's posting day; the tests' expectations assume it.
# CARDDEMO_BUSINESS_DATE=2022-07-06

# Where build output and job work directories go.
# CARDDEMO_BUILD_DIR=build

# Directory with the ASCII sample data files (custdata.txt, dailytran.txt, ...).
# CARDDEMO_DATA_DIR=app/data/ASCII

# Default program for `make run-batch`.
# PROGRAM=CBTRN02C

# Test runner (tests/run_tests.py) settings. Keep comments on their own
# lines: make keeps the spaces before a trailing comment in the value.
# Parallel workers; 0 = one per CPU.
# CARDDEMO_TEST_JOBS=0
# Extra attempts for a failing test (default from tests/test-config.toml).
# CARDDEMO_TEST_RETRIES=2
# Test order seed; 0 = a new random seed each run.
# CARDDEMO_TEST_SEED=0
# Seconds allowed per COBOL program run.
# CARDDEMO_TEST_TIMEOUT=120
# Paragraph coverage minimum in percent (default from tests/test-config.toml).
# CARDDEMO_COVERAGE_MIN=85
# 1 = a test that passes only on retry fails the run.
# CARDDEMO_FAIL_ON_FLAKY=0
# Extra run_tests.py arguments, e.g. -k posttran.
# TEST_ARGS=

# Extra arguments for scripts/lint.sh, e.g. --no-baseline.
# LINT_ARGS=
