  "paths" : {
    "/api/reports/transactions" : {
      "post" : {
        "operationId" : "requestTransactionReport",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ReportRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReportRun"
                }
              }
            },
            "description" : "Requested and started; message is the success text.",
            "headers" : {
              "Location" : {
                "description" : "/api/reports/transactions/{runId}",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "REPORT_TYPE_REQUIRED, START_/END_MONTH/DAY/YEAR_REQUIRED, START_/END_MONTH/DAY/YEAR_INVALID, START_DATE_INVALID, END_DATE_INVALID, DATE_RANGE_INVALID or CONFIRM_INVALID; the first failing check only."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCESS_DENIED (USER only) or CSRF."
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReportProblem"
                }
              }
            },
            "description" : "CONFIRM_REQUIRED, with the resolved range. Nothing written."
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INTERNAL_ERROR."
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "REPORT_TRIGGER_FAILED: the run is FAILED, TRIGGER_FAILED."
          }
        }
      }
    },
    "/api/reports/transactions/{runId}" : {
      "get" : {
