          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "REPORT_FILE_MISSING or INTERNAL_ERROR."
          }
        }
      }
    },
    "/api/transactions" : {
      "get" : {
        "operationId" : "listTransactions",
        "parameters" : [ {
          "description" : "Search Tran ID as typed: 1 to 16 digits, trailing spaces ignored, padded on the left with 0. The page starts at the first ID equal or greater.",
          "in" : "query",
          "name" : "start",
          "required" : false,
          "schema" : {
            "type" : "string",
            "examples" : [ "683580" ]
          }
        }, {
          "description" : "The lastKey of the page shown: the next page.",
          "in" : "query",
          "name" : "after",
          "required" : false,
          "schema" : {
            "type" : "string",
            "examples" : [ "0000000021711604" ],
            "pattern" : "^[0-9]{16}$"
          }
        }, {
          "description" : "The firstKey of the page shown: the previous page.",
          "in" : "query",
          "name" : "before",
          "required" : false,
          "schema" : {
            "type" : "string",
            "examples" : [ "0000000000683580" ],
            "pattern" : "^[0-9]{16}$"
          }
        }, {
          "description" : "Rows per page, 1 to 10; default 10, the screen's row count.",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 10,
            "maximum" : 10,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransactionPage"
                }
              }
            },
            "description" : "One page, ascending tran_id, with a notice (information) at either end of the list."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INVALID_CURSOR, INVALID_PAGE_SIZE or INVALID_SEARCH_TRAN_ID."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCESS_DENIED."
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "TRAN_LIST_FAILED."
          }
        }
      },
      "post" : {
        "operationId" : "addTransaction",
        "parameters" : [ {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TransactionForm"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AddResult"
                }
              }
            },
            "description" : "Added, or the stored result of the same key and body (header Idempotent-Replayed: true).",
            "headers" : {
              "Idempotent-Replayed" : {
                "schema" : {
                  "type" : "boolean"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransactionProblem"
                }
              }
            },
            "description" : "KEY_REQUIRED, INVALID_ACCT_ID, INVALID_CARD_NUM, CARD_CHOICE_REQUIRED (with cards), CARD_ACCOUNT_MISMATCH, FIELD_REQUIRED, UNSUPPORTED_CHARACTER, TOO_LONG, TYPE_NOT_NUMERIC, CATEGORY_NOT_NUMERIC, TYPE_NOT_FOUND, CATEGORY_NOT_FOUND, INVALID_AMOUNT, INVALID_ORIG_DATE_FORMAT, INVALID_ORIG_DATE or MERCHANT_ID_NOT_NUMERIC; the first failing check only; then INVALID_CONFIRM or IDEMPOTENCY_KEY_REQUIRED."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCESS_DENIED (USER only) or CSRF."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransactionProblem"
                }
              }
            },
            "description" : "ACCOUNT_NOT_FOUND or CARD_NOT_FOUND."
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "TRAN_ID_EXISTS."
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "TRAN_IDEMPOTENCY_KEY_REUSED: the key came with another body."
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransactionProblem"
                }
              }
            },
            "description" : "XREF_LOOKUP_FAILED, CARD_LOOKUP_FAILED, REFERENCE_LOOKUP_FAILED, TRAN_LOOKUP_FAILED or ADD_FAILED (also when no transaction ID is left)."
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "BATCH_WINDOW.",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds.",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        }
      }
    },
