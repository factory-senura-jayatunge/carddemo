  "components" : {
    "schemas" : {
      "AddResult" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string",
            "examples" : [ "acctId" ]
          },
          "hint" : {
            "$ref" : "#/components/schemas/Hint"
          },
          "message" : {
            "type" : "string",
            "examples" : [ "Transaction added successfully.  Your Tran ID is 9000000000000000." ]
          },
          "severity" : {
            "$ref" : "#/components/schemas/Severity"
          },
          "tranId" : {
            "type" : "string",
            "examples" : [ "9000000000000000" ]
          }
        },
        "required" : [ "field", "hint", "message", "severity", "tranId" ]
      },
      "Hint" : {
        "type" : "object",
        "properties" : {
          "message" : {
            "type" : "string",
            "examples" : [ "The transaction will be posted in the next batch cycle." ]
          },
          "severity" : {
            "$ref" : "#/components/schemas/Severity"
          }
        },
        "required" : [ "message", "severity" ]
      },
      "LatestTransaction" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "description" : "Decimal string, scale 2, as stored.",
            "examples" : [ "504.77" ]
          },
          "amountDisplay" : {
            "type" : "string",
            "description" : "+99999999.99 of the amount cut to eight integer digits (NUM-TRNA-001).",
            "examples" : [ "+00000504.77" ]
          },
          "catCd" : {
            "type" : "string",
            "examples" : [ "0001" ]
