{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Snapshot of the billpay-service OpenAPI document. The service's OpenApiExportTest fails when its export differs from this file.",
    "title" : "billpay-service",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/billpay/accounts/{acctId}" : {
      "get" : {
        "operationId" : "previewBillPayment",
        "parameters" : [ {
          "in" : "path",
          "name" : "acctId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Preview"
                }
              }
            },
            "description" : "Balance and the confirmation prompt (VAL-BILL-004, VAL-BILL-005)."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCT_ID_REQUIRED."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCESS_DENIED."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCOUNT_NOT_FOUND."
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCOUNT_LOOKUP_FAILED."
          }
        },
        "tags" : [ "billpay" ]
      }
    },
    "/api/billpay/accounts/{acctId}/payments" : {
      "post" : {
        "operationId" : "payBill",
        "parameters" : [ {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "acctId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PaymentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentResult"
                }
              }
            },
            "description" : "Paid, or the stored result of the same key (header Idempotent-Replayed: true).",
            "headers" : {
              "Idempotent-Replayed" : {
                "schema" : {
                  "type" : "boolean"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCT_ID_REQUIRED, INVALID_CONFIRM or IDEMPOTENCY_KEY_REQUIRED."
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED."
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCESS_DENIED or CSRF."
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCOUNT_NOT_FOUND."
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "TRAN_ID_EXISTS."
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaymentProblem"
                }
              }
            },
            "description" : "NOTHING_TO_PAY (with the balance) or IDEMPOTENCY_KEY_REUSED."
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "ACCOUNT_LOOKUP_FAILED, XREF_LOOKUP_FAILED, TRAN_LOOKUP_FAILED, TRAN_ADD_FAILED or ACCOUNT_UPDATE_FAILED."
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "BATCH_WINDOW.",
            "headers" : {
              "Retry-After" : {
                "description" : "Seconds.",
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        },
        "tags" : [ "billpay" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "PaymentProblem" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/Problem"
        }, {
          "type" : "object",
          "properties" : {
            "currentBalance" : {
              "type" : "string"
            },
            "currentBalanceDisplay" : {
              "type" : "string"
            }
          }
        } ]
      },
      "PaymentRequest" : {
        "type" : "object",
        "properties" : {
          "confirm" : {
            "type" : "string",
            "examples" : [ "Y" ],
            "maxLength" : 1
          }
        },
        "required" : [ "confirm" ]
      },
      "PaymentResult" : {
        "type" : "object",
        "properties" : {
          "acctId" : {
            "type" : "string"
          },
          "amount" : {
            "type" : "string",
            "examples" : [ "194.00" ]
          },
          "field" : {
            "type" : [ "string", "null" ]
          },
          "message" : {
            "type" : "string"
          },
          "severity" : {
            "$ref" : "#/components/schemas/Severity"
          },
          "tranId" : {
            "type" : "string",
            "examples" : [ "0000000000000001" ]
          }
        },
        "required" : [ "acctId", "amount", "field", "message", "severity", "tranId" ]
      },
      "Preview" : {
        "type" : "object",
        "properties" : {
          "acctId" : {
            "type" : "string",
            "examples" : [ "00000000001" ]
          },
          "currentBalance" : {
            "type" : "string",
            "description" : "Decimal string.",
            "examples" : [ "194.00" ]
          },
          "currentBalanceDisplay" : {
            "type" : "string",
            "description" : "Legacy edit +9999999999.99 (NUM-BILL-001).",
            "examples" : [ "+0000000194.00" ]
          },
          "field" : {
            "type" : [ "string", "null" ]
          },
          "message" : {
            "type" : "string"
          },
          "payable" : {
            "type" : "boolean"
          },
          "severity" : {
            "$ref" : "#/components/schemas/Severity"
          }
        },
        "required" : [ "acctId", "currentBalance", "currentBalanceDisplay", "field", "message", "payable", "severity" ]
      },
      "Problem" : {
        "type" : "object",
        "description" : "RFC 9457 problem details with the CardDemo fields. message is the exact catalogue text.",
        "properties" : {
          "code" : {
            "type" : "string",
            "examples" : [ "ACCT_ID_REQUIRED" ]
          },
          "detail" : {
            "type" : "string"
          },
          "field" : {
            "type" : [ "string", "null" ],
            "description" : "Field to focus, or null."
          },
          "instance" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "severity" : {
            "$ref" : "#/components/schemas/Severity"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "message", "severity" ]
      },
      "Severity" : {
        "type" : "string",
        "enum" : [ "error", "success", "info" ]
      }
    }
  }
}
