    "securitySchemes" : {
      "bearerToken" : {
        "bearerFormat" : "JWT",
        "description" : "The access token as Authorization: Bearer, for scripts. Without the session cookie no CSRF header is needed.",
        "scheme" : "bearer",
        "type" : "http"
      },
      "csrfHeader" : {
        "description" : "The value of the XSRF-TOKEN cookie (double submit), on every POST, PUT and DELETE sent with the session cookie, and on refresh and sign-off.",
        "in" : "header",
        "name" : "X-XSRF-TOKEN",
        "type" : "apiKey"
      },
      "refreshCookie" : {
        "description" : "The refresh token cookie (path /api/auth) that sign-on, password change and refresh set. Refresh uses it once; sign-off ends its session.",
        "in" : "cookie",
        "name" : "cd_rt",
        "type" : "apiKey"
      },
      "sessionCookie" : {
        "description" : "The access token cookie that sign-on, password change and refresh set. With it, POST, PUT and DELETE also need X-XSRF-TOKEN.",
        "in" : "cookie",
        "name" : "cd_at",
        "type" : "apiKey"
      }
    }
