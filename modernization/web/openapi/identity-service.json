{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Sign-on, password change, sessions and the JWKS of the CardDemo API.",
    "title" : "CardDemo identity-service",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/auth/.well-known/jwks.json" : {
      "get" : {
        "operationId" : "jwks",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : { }
                }
              }
            },
            "description" : "JWK set (RFC 7517)"
          }
        },
        "summary" : "The public key that signs access tokens",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "The session's user"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          }
        },
        "summary" : "The signed-on user",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/password" : {
      "post" : {
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Password changed and signed on; sets cd_at, cd_rt and XSRF-TOKEN"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "USER_ID_REQUIRED, PASSWORD_REQUIRED, INVALID_INPUT, USER_ID_MISMATCH or a NEW_PASSWORD_* rule"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "USER_NOT_FOUND, WRONG_PASSWORD or SIGN_ON_FAILED"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "USER_TYPE_NOT_ALLOWED"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "TOO_MANY_ATTEMPTS, with Retry-After"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "UNABLE_TO_VERIFY"
          }
        },
        "summary" : "Change the password with the current one, then start a session (D-SEC-07)",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "cd_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Session extended; new cd_at, cd_rt and XSRF-TOKEN"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "SESSION_EXPIRED; cookies cleared"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "CSRF_REJECTED"
          }
        },
        "summary" : "Use the refresh cookie once and get new cookies",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/sign-off" : {
      "post" : {
        "operationId" : "signOff",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "cd_rt",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SignOffResult"
                }
              }
            },
            "description" : "Signed off; cookies cleared"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "CSRF_REJECTED"
          }
        },
        "summary" : "End the session (FLOW-SGN-003)",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/sign-on" : {
      "post" : {
        "operationId" : "signOn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignOnRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionView"
                }
              }
            },
            "description" : "Signed on; sets cd_at, cd_rt and XSRF-TOKEN"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "USER_ID_REQUIRED, PASSWORD_REQUIRED or INVALID_INPUT"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "USER_NOT_FOUND, WRONG_PASSWORD or SIGN_ON_FAILED"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "USER_TYPE_NOT_ALLOWED or PASSWORD_CHANGE_REQUIRED (severity info)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "TOO_MANY_ATTEMPTS, with Retry-After"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "UNABLE_TO_VERIFY"
          }
        },
        "summary" : "Sign on (COSGN00C) and start a session",
        "tags" : [ "auth" ]
      }
    },
    "/api/features" : {
      "get" : {
        "operationId" : "features",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Features"
                }
              }
            },
            "description" : "What the web app shows"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblem"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          }
        },
        "summary" : "Installed modules, converted units and UI switches",
        "tags" : [ "features" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ApiProblem" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "field" : {
            "type" : [ "string", "null" ],
            "description" : "The field to focus, or null"
          },
          "message" : {
            "type" : "string",
            "description" : "The exact screen text"
          },
          "severity" : {
            "type" : "string",
            "enum" : [ "error", "success", "info" ]
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "detail", "field", "message", "severity", "status", "title", "type" ]
      },
      "Features" : {
        "type" : "object",
        "properties" : {
          "converted" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "modules" : {
            "$ref" : "#/components/schemas/Modules"
          },
          "uiSwitches" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            },
            "description" : "Spec item ID to legacy or fixed"
          }
        },
        "required" : [ "converted", "modules", "uiSwitches" ]
      },
      "Modules" : {
        "type" : "object",
        "properties" : {
          "authorization" : {
            "type" : "boolean"
          },
          "transactionTypes" : {
            "type" : "boolean"
          }
        },
        "required" : [ "authorization", "transactionTypes" ]
      },
      "PasswordRequest" : {
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string",
            "maxLength" : 64
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 64
          },
          "userId" : {
            "type" : "string",
            "description" : "Required without a session; with one, omitted or the session's user",
            "maxLength" : 8
          }
        },
        "required" : [ "currentPassword", "newPassword" ]
      },
      "SessionView" : {
        "type" : "object",
        "properties" : {
          "firstName" : {
            "type" : "string"
          },
          "home" : {
            "type" : "string",
            "enum" : [ "/", "/admin" ]
          },
          "idleTimeoutSeconds" : {
            "type" : "integer",
            "format" : "int64"
          },
          "lastName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "USER", "ADMIN" ]
          },
          "userId" : {
            "type" : "string"
          },
          "userType" : {
            "type" : "string",
            "description" : "The stored legacy type, e.g. A or U"
          }
        },
        "required" : [ "firstName", "home", "idleTimeoutSeconds", "lastName", "role", "userId", "userType" ]
      },
      "SignOffResult" : {
        "type" : "object",
        "properties" : {
          "message" : {
            "type" : "string"
          },
          "severity" : {
            "type" : "string",
            "enum" : [ "info" ]
          }
        },
        "required" : [ "message", "severity" ]
      },
      "SignOnRequest" : {
        "type" : "object",
        "properties" : {
          "password" : {
            "type" : "string",
            "maxLength" : 64
          },
          "userId" : {
            "type" : "string",
            "maxLength" : 8
          }
        },
        "required" : [ "password", "userId" ]
      }
    }
  }
}
