          "firstName" : {
            "type" : "string",
            "maxLength" : 20
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 20
          },
          "userId" : {
            "type" : "string",
            "description" : "The canonical user ID",
            "maxLength" : 8
          },
          "userType" : {
            "type" : "string",
            "description" : "A or U; a legacy-loaded user may hold another type"
