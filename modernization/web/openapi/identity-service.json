    "/api/users" : {
      "get" : {
        "operationId" : "listUsers",
        "parameters" : [ {
          "description" : "Case-insensitive user ID prefix, as typed",
          "in" : "query",
          "name" : "start",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The same prefix in key form: base64url of its UTF-8 bytes, no padding",
          "in" : "query",
          "name" : "startKey",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "lastKey of the previous page: the next page",
          "in" : "query",
          "name" : "after",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "firstKey of the current page: the previous page",
          "in" : "query",
          "name" : "before",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Rows, 1 to 10",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "default" : 10,
            "maximum" : 10,
            "minimum" : 1
