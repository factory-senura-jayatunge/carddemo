{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "useDefineForClassFields": true,
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@carddemo/validation/*": ["src/api/generated/validation/*"],
      "@carddemo/validation-data/*": ["../platform/validation/src/main/resources/org/carddemo/platform/validation/*"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts", "scripts/*.d.mts"]
}
