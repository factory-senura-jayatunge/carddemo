{
  "name": "carddemo-web",
  "private": true,
  "version": "0.1.0",
  "description": "CardDemo web app: React front end of the modernized CardDemo.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:messages": "node scripts/gen-messages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "budget": "node scripts/check-bundle.mjs",
    "verify": "npm run gen:api && npm run typecheck && npm run lint && npm run test && npm run build && npm run budget",
    "e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "preview": "vite preview --host 127.0.0.1 --port 25173 --strictPort"
  },
  "bundleBudget": {
    "initialJsGzipKiB": 190,
    "totalJsGzipKiB": 260,
    "totalCssGzipKiB": 40
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@tanstack/react-query": "5.106.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
