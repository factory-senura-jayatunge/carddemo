<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.carddemo</groupId>
    <artifactId>carddemo-modernization-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>verify-data</artifactId>
  <name>CardDemo data reconciliation</name>
  <description>make verify-data: reconciles the loaded core and reference tables and users with the legacy sample files and lookup lists.</description>

  <dependencies>
    <dependency>
      <groupId>org.carddemo</groupId>
      <artifactId>legacy-format</artifactId>
    </dependency>
    <dependency>
      <groupId>org.carddemo</groupId>
      <artifactId>validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.carddemo</groupId>
      <artifactId>batch-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.carddemo</groupId>
      <artifactId>db-migrate</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.carddemo</groupId>
      <artifactId>test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The tests seed iam.app_user with identity-service's own seeder, as the stack does. -->
    <dependency>
      <groupId>org.carddemo</groupId>
      <artifactId>identity-service</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.carddemo.verify.data.VerifyData</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
