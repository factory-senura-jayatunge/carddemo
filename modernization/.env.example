# Settings for the modernized CardDemo stack. `make setup` copies this file
# to .env (git-ignored) and fills in every empty *_PASSWORD / *_PASS value
# with a random one. Never commit .env or put real passwords in this file.
# Keep values on one line, without quotes or trailing comments.

# SQL Server 2025 (application data). The SA password is fixed when the
# volume is first created; to change it later, wipe the volume
# (make infra-wipe CONFIRM=1).
MSSQL_SA_PASSWORD=
MSSQL_PID=Developer
MSSQL_HOST_PORT=21433

# RabbitMQ 4.4 (messaging). Queues are durable quorum queues by default.
RABBITMQ_DEFAULT_USER=carddemo
RABBITMQ_DEFAULT_PASS=
RABBITMQ_AMQP_HOST_PORT=25672
RABBITMQ_MGMT_HOST_PORT=35672

# Postgres 17 (Airflow metadata only; application data stays in SQL Server).
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_HOST_PORT=25432

# Toolchain overrides. By default the Makefile finds JDK 21, Node 24 and the
# Airflow venv by itself (see README.md, "Toolchain pinning").
# CARDDEMO_JAVA_HOME=/path/to/jdk-21
# CARDDEMO_NODE_BIN=/path/to/node-24/bin
# AIRFLOW_VENV=/path/to/venv
