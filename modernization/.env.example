# Settings for the modernized CardDemo stack. `make setup` copies this file
# to .env (git-ignored) and fills in every empty *_PASSWORD / *_PASS value
# with a random one. Never commit .env or put real passwords in this file.
# Keep values on one line, without quotes or trailing comments.

# SQL Server 2025 (application data). The SA password is fixed when the
# volume is first created; to change it later, wipe the volume
# (make infra-wipe CONFIRM=1).
MSSQL_SA_PASSWORD=
MSSQL_PID=Developer
MSSQL_HOST_PORT=21433
# SQL Server caps its own memory here (mssql-conf memory.memorylimitmb), so
# the Colima VM keeps room for a Testcontainers instance during tests.
MSSQL_MEMORY_LIMIT_MB=2048

# Application database and the SQL login of each service (created by
# db-migrate). SQL Server's password policy applies; generated values meet it.
CARDDEMO_DB_NAME=carddemo
CARDDEMO_DB_IDENTITY_PASSWORD=
CARDDEMO_DB_BILLPAY_PASSWORD=
CARDDEMO_DB_ACCOUNT_PASSWORD=
CARDDEMO_DB_TRANSACTION_PASSWORD=
CARDDEMO_DB_REFERENCE_PASSWORD=
CARDDEMO_DB_AUTHORIZATION_PASSWORD=
CARDDEMO_DB_INQUIRY_PASSWORD=
CARDDEMO_DB_BATCH_PASSWORD=

# Test database (backend test-support). An empty URL means Testcontainers,
# as in CI. To run the tests against the compose SQL Server instead, set the
# server URL without databaseName, for example
#   CARDDEMO_TEST_MSSQL_URL=jdbc:sqlserver://127.0.0.1:21433;encrypt=true;trustServerCertificate=true
# Each agent or checkout sets its own CARDDEMO_TEST_MSSQL_DB in its
# environment (carddemo_test_backend, ...). CARDDEMO_TEST_MSSQL_PASSWORD
# defaults to MSSQL_SA_PASSWORD when the user is sa; set it only for another
# login.
CARDDEMO_TEST_MSSQL_URL=
CARDDEMO_TEST_MSSQL_USER=sa
CARDDEMO_TEST_MSSQL_DB=carddemo_test

# RabbitMQ 4.4 (messaging). Queues are durable quorum queues by default.
RABBITMQ_DEFAULT_USER=carddemo
RABBITMQ_DEFAULT_PASS=
RABBITMQ_AMQP_HOST_PORT=25672
RABBITMQ_MGMT_HOST_PORT=35672

# Postgres 17 (Airflow metadata only; application data stays in SQL Server).
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_HOST_PORT=25432

# identity-service. The 10 seed users (ADMIN001, USER0001, ...) of the demo
# profile get this password; it replaces the PASSWORD of the mainframe demo
# data. setup generates 8 upper-case letters and digits, so it fits the
# legacy 8-character field and signs on in both fidelity modes. The JWT
# signing key is not here: setup writes it to var/secrets/identity-jwt.pem.
CARDDEMO_SEED_USER_PASSWORD=

# Toolchain overrides. By default the Makefile finds JDK 21, Node 24 and the
# Airflow venv by itself (see README.md, "Toolchain pinning").
# CARDDEMO_JAVA_HOME=/path/to/jdk-21
# CARDDEMO_NODE_BIN=/path/to/node-24/bin
# AIRFLOW_VENV=/path/to/venv
