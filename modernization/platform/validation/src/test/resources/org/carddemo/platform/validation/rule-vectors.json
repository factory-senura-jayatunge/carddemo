{
 "note": "Expected results written from the account update spec (COACTUPC section 8) and the rule table semantics; run by FormRulesVectorsTest and rules.test.ts.",
 "rules": {
  "schema": 1,
  "forms": {
   "account": {
    "fields": [
     {
      "name": "acctStatus",
      "label": "Account Status",
      "checks": [
       {
        "kind": "required",
        "emptyValues": [
         "0"
        ]
       },
       {
        "kind": "yesNo"
       }
      ]
     },
     {
      "kind": "date",
      "label": "Open Date",
      "parts": {
       "year": "openYear",
       "month": "openMonth",
       "day": "openDay"
      }
     },
     {
      "name": "creditLimit",
      "label": "Credit Limit",
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "amount",
        "maxIntegerDigits": 10,
        "maxScale": 2
       },
       {
        "kind": "amountRange",
        "min": "0",
        "code": "CREDIT_LIMIT_NEGATIVE",
        "message": "{label} must not be negative"
       }
      ]
     },
     {
      "name": "ssn1",
      "label": "SSN: First 3 chars",
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "numeric",
        "length": 3
       },
       {
        "kind": "nonZero"
       },
       {
        "kind": "notIn",
        "values": [
         0,
         666
        ],
        "ranges": [
         [
          900,
          999
         ]
        ],
        "message": "SSN: First 3 chars: should not be 000, 666, or between 900 and 999"
       }
      ]
     },
     {
      "name": "ssn2",
      "label": "SSN 4th & 5th chars",
      "requiresValid": [
       "ssn1"
      ],
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "numeric",
        "length": 2
       },
       {
        "kind": "nonZero"
       }
      ]
     },
     {
      "name": "ficoScore",
      "label": "FICO Score",
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "numeric",
        "length": 3
       },
       {
        "kind": "nonZero"
       },
       {
        "kind": "range",
        "min": 300,
        "max": 850,
        "message": "FICO Score: should be between 300 and 850"
       }
      ]
     },
     {
      "name": "firstName",
      "label": "First Name",
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "maxLength",
        "length": 25
       },
       {
        "kind": "alphabetic",
        "extra": "-'."
       }
      ]
     },
     {
      "name": "middleName",
      "label": "Middle Name",
      "checks": [
       {
        "kind": "alphabetic"
       }
      ]
     },
     {
      "name": "state",
      "label": "State",
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "alphabetic"
       },
       {
        "kind": "inList",
        "list": "usStateCodes",
        "ignoreCase": true,
        "message": "State: is not a valid state code"
       }
      ]
     },
     {
      "name": "zip",
      "label": "Zip",
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "numeric",
        "length": 5
       },
       {
        "kind": "nonZero"
       }
      ]
     },
     {
      "kind": "phone",
      "label": "Phone Number 1",
      "parts": {
       "area": "phone1Area",
       "prefix": "phone1Prefix",
       "line": "phone1Line"
      }
     },
     {
      "kind": "date",
      "label": "Date of Birth",
      "parts": {
       "year": "dobYear",
       "month": "dobMonth",
       "day": "dobDay"
      },
      "notFuture": true
     },
     {
      "name": "primaryHolder",
      "label": "Primary Card Holder",
      "checks": [
       {
        "kind": "required",
        "emptyValues": [
         "0"
        ]
       },
       {
        "kind": "yesNo",
        "ignoreCase": true
       }
      ]
     },
     {
      "kind": "stateZip",
      "state": "state",
      "zip": "zip",
      "ignoreCase": true
     }
    ]
   },
   "dates": {
    "fields": [
     {
      "kind": "date",
      "label": "Reissue Date",
      "parts": {
       "year": "y",
       "month": "m",
       "day": "d"
      },
      "minYear": 1000,
      "maxYear": 9999
     },
     {
      "kind": "date",
      "label": "Date of Birth",
      "parts": {
       "year": "by",
       "month": "bm",
       "day": "bd"
      },
      "notFuture": true,
      "allowToday": true,
      "messages": {
       "DATE_FUTURE": "{label}: must not be after today"
      }
     }
    ]
   },
   "amounts": {
    "fields": [
     {
      "name": "amt",
      "label": "Credit Limit",
      "checks": [
       {
        "kind": "required"
       },
       {
        "kind": "amount",
        "maxIntegerDigits": 10,
        "maxScale": 2
       }
      ]
     }
    ]
   }
  }
 },
