{
 "about": "COBOL FUNCTION UPPER-CASE on legacy text: a to z become A to Z and nothing else changes. Run by LegacyCaseVectorsTest (platform/legacy-format's LegacyCase.upper) and by legacyCase.test.ts (the TypeScript mirror).",
 "vectors": [
  {
   "in": "user0001",
   "out": "USER0001",
   "note": "a user ID typed in lower case"
  },
  {
   "in": "Abc xyz1",
   "out": "ABC XYZ1",
   "note": "mixed case, a space and a digit"
  },
  {
   "in": "0123456789 -_.",
   "out": "0123456789 -_.",
   "note": "no letters"
  },
  {
   "in": "ABCDEFGH",
   "out": "ABCDEFGH",
   "note": "already upper case"
  },
  {
   "in": "`az{@AZ[",
   "out": "`AZ{@AZ[",
   "note": "the ASCII neighbours of a, z, A and Z stay"
  },
  {
   "in": "",
   "out": "",
   "note": "empty"
  },
  {
   "in": "\u00e9",
   "out": "\u00e9",
   "note": "e acute: toUpperCase gives E acute"
  },
  {
   "in": "\u00df",
   "out": "\u00df",
   "note": "sharp s: toUpperCase gives SS, two characters"
  },
  {
   "in": "\u00ff",
   "out": "\u00ff",
   "note": "y diaeresis: toUpperCase gives U+0178, outside Latin-1"
  },
  {
   "in": "\u00b5",
   "out": "\u00b5",
   "note": "micro sign: toUpperCase gives Greek capital mu"
  },
  {
   "in": "\u00e9a\u0000\u00ffz",
   "out": "\u00e9A\u0000\u00ffZ",
   "note": "Latin-1 letters and NUL around a and z"
  },
  {
   "in": "ab/c\u0000d",
   "out": "AB/C\u0000D",
   "note": "a user ID holding a slash and NUL"
  },
  {
   "in": "\u0131 i \ud83d\ude00 \ufb00",
   "out": "\u0131 I \ud83d\ude00 \ufb00",
   "note": "dotless i, a surrogate pair and the ff ligature pass through"
  },
  {
   "in": "\u01c6",
   "out": "\u01c6",
   "note": "dz digraph: toUpperCase gives U+01C4"
  },
  {
   "in": "\uff41\uff5a",
   "out": "\uff41\uff5a",
   "note": "full-width a and z"
  },
  {
   "in": "\ud800a",
   "out": "\ud800A",
   "note": "a lone high surrogate before a"
  },
